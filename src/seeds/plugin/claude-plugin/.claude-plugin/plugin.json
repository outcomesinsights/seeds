{
  "name": "seeds",
  "description": "Deliberation workflow skills for the seeds CLI",
  "version": "0.7.2",
  "author": {
    "name": "Outcomes Insights"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "seeds prime"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${HERDR_PANE_ID:-}\" ] && command -v python3 >/dev/null 2>&1; then python3 \"${CLAUDE_PLUGIN_ROOT}/skills/tend/tend_clear.py\" mark-cleared; fi"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "seeds prime"
          }
        ]
      }
    ]
  }
}
